# ============================================
# ZSMS Environment Variables
# Copy this file to .env.local and fill in values
# See docs/ENVIRONMENT.md for detailed instructions
# ============================================

# --- DATABASE (Required) ---
DATABASE_URL=postgresql://...          # Neon PostgreSQL connection string (pooled)
DIRECT_URL=postgresql://...            # Neon direct URL for migrations (non-pooler)

# --- AUTH (Required) ---
JWT_SECRET=                            # Min 32 chars random string
JWT_REFRESH_SECRET=                    # Min 32 chars â€” required for production refresh tokens
# JWT_SECRET_PREVIOUS=                 # Set ONLY during a JWT_SECRET rotation window so tokens
#                                      # signed with the old secret keep verifying until they expire.
#                                      # Remove after the window. See docs/SECRET_ROTATION.md.
NEXTAUTH_SECRET=                       # Legacy NextAuth secret if used
NEXTAUTH_URL=http://localhost:3000

# --- EMAIL (Required) ---
RESEND_API_KEY=re_...                  # Get from resend.com (free tier: 3,000/month)
EMAIL_FROM_NOREPLY=ZSMS <noreply@yourdomain.com>  # Verified sender in Resend
# EMAIL_FROM=noreply@yourdomain.com    # Alias â€” use if EMAIL_FROM_NOREPLY unset
EMAIL_INFO=info@yourdomain.com         # Contact form recipient
# PILOT_NOTIFY_EMAILS=you@example.com,ops@example.com  # Alert when a school joins free trial (pilot)

# --- AI (Required for AI features — Groq primary; Gemini → OpenRouter → OpenAI → HF) ---
GROQ_API_KEY=gsk_...                   # console.groq.com (FREE: 14,400 req/day)
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=                      # aistudio.google.com — FREE fallback (gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash
#
# OpenRouter fallback (openrouter.ai) — used when Groq/Gemini fail or are unset
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_SITE_URL=https://bluepeacktechnologies.com
# OPENROUTER_APP_NAME=Zambian School Management System
# OPENAI_API_KEY=                      # Optional later fallback (api.openai.com)
# OPENAI_MODEL=gpt-4o-mini
# HUGGINGFACE_API_KEY=hf_...           # Optional last-resort chat + RAG embeddings

# --- CODE PLAYGROUND ---
# HTML/CSS: live iframe preview. JavaScript: in-browser sandbox. Python: in-browser Pyodide.
# Java / C / C++ / C# / Bash still need Piston (public emkc.org execute requires a key since 2026-02-15):
# PISTON_API_URL=https://emkc.org/api/v2/piston/execute
# PISTON_API_KEY=                      # Required for emkc.org execute, or use a self-hosted Piston URL
# PISTON_API_TOKEN=                    # Alias for PISTON_API_KEY

# --- RAG (Optional — grounds AI in school-uploaded notes; free tier) ---
# HUGGINGFACE_API_KEY=hf_...           # huggingface.co — all-MiniLM-L6-v2 embeddings (free + fallback)
# GEMINI_API_KEY=                      # aistudio.google.com — primary paid embed when set (384-dim)
# JINA_API_KEY=                        # jina.ai — jina-embeddings-v3 @ 384d
# OPENROUTER_API_KEY=                  # same key as chat — embeddings via OPENROUTER_EMBED_MODEL
# OPENAI_API_KEY=                      # Paid plans — text-embedding-3-small @ 384d
# VOYAGE_API_KEY=                      # Paid plans — when others unset; batched with rate-limit retry
# RAG_EMBED_PROVIDER=gemini            # Optional pin (gemini|jina|openrouter|openai|voyage|huggingface)
# OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
# HUGGINGFACE_CHAT_MODEL=meta-llama/Llama-2-7b-chat-hf
# JINA_EMBED_MODEL=jina-embeddings-v3
# VOYAGE_EMBED_MODEL=voyage-3-lite
# VOYAGE_EMBED_BATCH_SIZE=8
# VOYAGE_EMBED_BATCH_DELAY_MS=21000
# VOYAGE_RATE_LIMIT_SLEEP_MS=20000
# BLOB_READ_WRITE_TOKEN=               # Vercel Blob — enables direct large-file (up to 50MB) RAG uploads.
#                                      # Create a Blob store in the Vercel dashboard (Storage > Blob); the
#                                      # token is added automatically on Vercel. Without it, uploads fall
#                                      # back to ~4MB direct uploads.

# --- Cloudflare R2 (Phase 3 chat lesson-plan .docx storage â€” signed downloads) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_URL=                       # Optional; downloads use signed URLs, not this public base
# R2_ENDPOINT=                         # Optional override (default https://{accountId}.r2.cloudflarestorage.com)

# Chat lesson-plan Syllabus Readiness Index (Phase 4)
# Required approved plans per term until real syllabus targets are wired.
# LESSON_PLAN_REQUIRED_PER_TERM=12
# Without R2 credentials, .docx files are stored under .uploads/lesson-plans/ (local/dev).

# --- PAYMENTS (Optional — payments disabled if missing) ---
LIPILA_API_KEY=
LIPILA_BASE_URL=https://api.lipila.dev  # Production: https://blz.lipila.io
# openssl rand -hex 32 — required for Lipila POST callbacks (also auto-appended to callbackUrl)
LIPILA_WEBHOOK_SECRET=
# Optional HMAC-SHA256 of raw body (hex) via x-lipila-signature; set LIPILA_REQUIRE_HMAC=true to enforce
# LIPILA_WEBHOOK_HMAC_SECRET=
# LIPILA_REQUIRE_HMAC=false

# --- SMS (Optional — SMS disabled if missing) ---
# ZSMS_ONBOARDING_SENDER_ID=ZSMS    # Onboarding welcome SMS sender (default ZSMS)
AFRICASTALKING_API_KEY=
AFRICASTALKING_USERNAME=
# openssl rand -hex 32 — required for /api/sms/inbound and /api/sms/delivery
SMS_WEBHOOK_SECRET=
# AFRICAS_TALKING_API_KEY=           # alias accepted by lib/config/env.js
# AFRICAS_TALKING_USERNAME=          # alias accepted by lib/config/env.js
# AFRICASTALKING_SENDER_ID=          # ZICTA-approved shortcode (optional; school SMS + bulk)
# Custom Android SIM gateway (tried first when enabled + online) — openssl rand -hex 32
# SMS_GATEWAY_ENCRYPTION_KEY=
# --- Bulk SMS queue (Upstash QStash — required for /api/sms/broadcast) ---
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
# QSTASH_CALLBACK_URL=https://your-production-domain.example/
#   (public HTTPS URL QStash uses to call queue-worker; trailing slash is stripped in code)
# SMS_PREFER_CUSTOM_GATEWAY=true   # optional: Android gateway first (cost mode); default is Africa's Talking first

# --- APP / MULTI-TENANT ---
# APP_BASE_DOMAIN=your-saas-domain.example
# BASE_DOMAIN=your-saas-domain.example
# COOKIE_DOMAIN=.your-saas-domain.example
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
ALLOW_DIRECT_SCHOOL_REGISTRATION=false

# --- RATE LIMITING (Optional — Upstash Redis; enables distributed AI/API limits) ---
# UPSTASH_REDIS_REST_URL=https://....upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# --- MONITORING (Optional but strongly recommended in production) ---
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=               # Same DSN — required for browser + tunnel /monitoring
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=                    # Source maps (or Vercel Sentry integration)
# SENTRY_UPLOAD_SOURCEMAPS=1            # Opt in: enables Sentry source map upload on build (high RAM on Vercel)

# --- VERCEL WEB ANALYTICS (platform overview traffic) ---
# VERCEL_API_TOKEN=                     # vercel.com/account/tokens — read Analytics for /platform/overview
# VERCEL_PROJECT_ID=                    # Project Settings → General
# VERCEL_TEAM_ID=                       # Team Settings → General (team_…)

# --- LOCAL DEVELOPMENT ---
# LOCAL_DEV_SCHOOL_SUBDOMAIN=your-school-subdomain
# LOCAL_DEV_PASSWORD=                   # openssl rand -base64 18 — never commit a real password
# DEV_ONBOARDING_SKIP_EMAIL=true
# NEXT_PUBLIC_SHOW_DEV_LOGIN_HINT=true

# --- VERCEL CRON (Optional) ---
CRON_SECRET=                          # Random string — protects /api/cron/* endpoints
# HTTP POST /api/notifications/send-immediate as cron also requires header:
#   x-zsms-cron-binding = HMAC-SHA256(CRON_SECRET, "send-immediate:v1:{schoolId}:{userId}")
# Prefer in-process notification cron (does not trust client schoolId).

# --- APPLICATION ---
NEXT_PUBLIC_APP_NAME="Zambian School Management System"
NEXT_PUBLIC_APP_VERSION=2.1.0
NEXT_PUBLIC_PWA_ENABLED=true
NEXT_PUBLIC_OFFLINE_MODE=true
# Server-only AES key (openssl rand -base64 32). Never use NEXT_PUBLIC_ for encryption keys.
SERVER_ENCRYPTION_KEY=

# --- SANITY CMS (optional — editable marketing homepage at /api/public/marketing-homepage) ---
# SANITY_PROJECT_ID=
# SANITY_DATASET=production
# SANITY_API_READ_TOKEN=                    # sanity.io/manage -> API -> Tokens

# --- PUBLIC MARKETING STATS (optional — homepage only; never exact live Student/Result counts) ---
# MARKETING_PUBLIC_STUDENTS=
# MARKETING_PUBLIC_TEACHERS=
# MARKETING_PUBLIC_RESULTS=

# --- PLATFORM ADMIN (required for seed:platform-admin — sign in at /login on apex domain) ---
# PLATFORM_ADMIN_EMAIL=
# PLATFORM_ADMIN_PASSWORD=                  # min 12 chars; required by seed script

# --- AI CHAT HANDOFF (Phase 2 — optional; handoff works without Telegram/DO) ---
# TELEGRAM_BOT_TOKEN=                   # BotFather token — metadata-only alerts (never message content)
# TELEGRAM_CHAT_ID=                     # Destination chat/channel id for handoff + gateway health pings
# CALLMEBOT_PHONE=                      # WhatsApp number, international digits only (no +), e.g. 26097xxxxxxx
# CALLMEBOT_APIKEY=                     # CallMeBot API key after opt-in to +34 644 59 71 67
# CHAT_DO_SHARED_SECRET=                # Shared with chat-realtime Worker (HMAC tickets + /internal/*)
# NEXT_PUBLIC_CHAT_DO_WSS_URL=          # e.g. wss://zsms-chat-realtime.<account>.workers.dev
# CHAT_DO_WSS_URL=                      # Optional server-side alias (same host, https://… also ok)

# --- PAYMENT LOGOS (optional — or use public/payments/*.jpg|png) ---
# NEXT_PUBLIC_PAYMENT_LOGO_MTN=/payments/mtn.jpg
# NEXT_PUBLIC_PAYMENT_LOGO_AIRTEL=/payments/airtel.jpg
# NEXT_PUBLIC_PAYMENT_LOGO_ZAMTEL=/payments/zamtel.png


GEMINI_API_KEY=your_key_here
