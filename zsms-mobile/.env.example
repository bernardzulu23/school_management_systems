# Use www — apex host 308-redirects and strips Authorization on follow.
EXPO_PUBLIC_API_BASE_URL=https://www.bluepeacktechnologies.com
# Root domain for web dashboard links (no https:// prefix)
EXPO_PUBLIC_WEB_BASE=bluepeacktechnologies.com

# Android emulator → host machine:
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000
