{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PastPaperStructure",
  "type": "object",
  "required": [
    "paperNumber",
    "year",
    "totalMarks",
    "durationMinutes",
    "calculatorAllowed",
    "sections"
  ],
  "properties": {
    "paperNumber": { "type": "integer" },
    "year": { "type": "integer", "minimum": 1990, "maximum": 2100 },
    "totalMarks": { "type": "integer", "minimum": 1 },
    "durationMinutes": { "type": "integer", "minimum": 1 },
    "calculatorAllowed": { "type": "boolean" },
    "formulaSheetProvided": { "type": "boolean" },
    "roundingRule": { "type": "string" },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["questionCount", "choiceRule"],
        "properties": {
          "sectionLabel": { "type": ["string", "null"] },
          "questionCount": { "type": "integer", "minimum": 1 },
          "choiceRule": { "type": "string", "enum": ["answer_all", "answer_n_of_m"] },
          "chooseCount": { "type": "integer" },
          "totalMarks": { "type": "integer" },
          "marksPerQuestion": { "type": "integer" },
          "answerLocation": { "type": "string" }
        },
        "allOf": [
          {
            "if": { "properties": { "choiceRule": { "const": "answer_n_of_m" } } },
            "then": { "required": ["chooseCount"] }
          }
        ]
      }
    },
    "topicCoverage": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "topic": { "type": "string" },
          "questionRefs": { "type": "array", "items": { "type": "string" } },
          "typicalMarks": { "type": "integer" },
          "needsReview": { "type": "boolean" }
        }
      }
    },
    "needsReview": { "type": "boolean" }
  }
}
